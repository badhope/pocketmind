# Android / Gradle（termux/apk-shell 构建产物与本机配置）
local.properties
*.apk
*.aab
*.keystore
*.jks
**/apk-shell/.gradle/
**/apk-shell/app/build/
**/apk-shell/build/

# 口袋 Agent：web/dist 需随仓库分发（手机端纯 pip 安装，不构建前端）
!agentd/web/dist/
!agentd/web/dist/**
website/_shots/

# AutoClaw 运行目录（本地代理工作区，不入库）
.zwork/

# 本地工具的运行时残留（如 video2code 插件写入的 .v2c/plugin_root），与项目无关
.v2c/

.aqg/

# Windows 设备保留名，测试脚本（run_shell）误生成的空文件，不入库
nul

# 覆盖率临时文件（coverage run 会产生 .coverage* / .cov.t*）
.coverage
.coverage.*
.cov.t*

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 访问本机 agentd 服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 原生工具所需权限（运行时按工具逐项检查，未授予时返回结构化错误而非崩溃） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- scan_wifi 读 WifiManager.getScanResults 需要它；漏了会 SecurityException -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!--
      相机 / 电话 / 短信相关的 uses-feature 全部 required=false：
      不声明时 Google Play 会按权限反推「必须支持该硬件」，把这些设备
      （平板、ChromeOS、部分无通话平板）直接过滤掉。本应用缺这些硬件时
      对应工具会返回 permission_required 或 hardware_unavailable，其余功能照常。
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- Android 13+ 通知权限：审批提醒、定时任务到达 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!-- 振动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 一键部署/启动服务：调用 Termux 的 RunCommandService 需要此权限 -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 14+ 前台服务（special_use）；Android 13 前台服务使用 dataSync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="34" />

    <!-- Android 11+ 包可见性：允许查询 Termux 是否已安装 -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!--
      定时任务：AlarmManager 精确闹钟（Android 12+ 必须显式声明）。
      Android 14 起新装应用默认不给 SCHEDULE_EXACT_ALARM，所以运行时要查
      canScheduleExactAlarms()，未授予则降级 setAndAllowWhileIdle（可能延迟数分钟）。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="31" />

    <!-- 开机自启：重启后恢复前台引擎与定时任务（系统默认不会拉起任何应用） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      电池优化豁免：Android 的 Doze/App Standby 会在锁屏后冻结后台进程，
      前台服务虽不被直接杀，但网络与 CPU 会被限制，agentd 掉线检测和定时
      任务回调都会延迟。此权限仅用于引导用户手动加入白名单（旁加载分发，
      不走 Play 政策）；不申请会被系统忽略请求。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      allowBackup=false：本应用持有局域网访问令牌（存在 WebView localStorage），
      Android 默认的自动备份会把它同步到云端，与「数据只留在设备上」的承诺冲突。
      usesCleartextTraffic=false：明文只由 network_security_config 对 127.0.0.1 放行。
      enableOnBackInvokedCallback=true：Android 13+ 走预测性返回，
      由 OnBackInvokedDispatcher 接管（见 MainActivity），否则返回手势会直接退出应用，
      WebView 的历史回退失效。
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          口袋智灵守护服务：
          - API 34+ 用 specialUse，API 33 用 dataSync。
          - 运行时传的 foregroundServiceType 必须是 manifest 声明的子集，
            否则 startForeground 抛 IllegalArgumentException（API 33 上会直接崩）。
        -->
        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/monitor_fgs_subtype" />
        </service>

        <!--
          原生引擎服务（单 APK 可用的核心）：进程内 HTTP/SSE + 工具 + SQLite。
          Termux 未安装时它是唯一后端；Termux 存在时二者并存、原生优先。
        -->
        <service
            android:name=".runtime.NativeEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_agent_engine" />
        </service>

        <!-- 定时任务触发：AlarmManager → 广播 → 后台线程跑 Agent -->
        <receiver
            android:name=".runtime.JobAlarmReceiver"
            android:exported="false" />

        <!--
          开机自启：重启后把前台引擎与定时任务恢复回来。
          exported=false 仍能收到系统广播（BOOT_COMPLETED 由系统进程发出，
          不受导出限制），同时避免第三方应用伪造该 action 拉起我们的服务。
        -->
        <receiver
            android:name=".runtime.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
